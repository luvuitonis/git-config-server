server:
  port: 8099

# Swagger UI
springdoc:
  swagger-ui:
    enabled: true
    path: /docs
    use-root-path: false
  api-docs:
    path: /api-docs

# Ambiente de Prod
spring:
  datasource:
    url: jdbc:h2:mem:ecommercedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
    driverClassName: org.h2.Driver
    username: sa
    password:
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
  h2:
    console:
      enabled: true
      path: /h2-console
